<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mindcurv.b2x.productcatalog</groupId>
        <artifactId>mc3s-b2x-productcatalog</artifactId>
        <version>0-SNAPSHOT</version>
    </parent>

    <artifactId>mc3s-b2x-aggregator-productreview</artifactId>
    <version>0-SNAPSHOT</version>
    <packaging>jar</packaging>


    <properties>
        <version>${project.version}</version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.mindcurv.b2x.productcatalog</groupId>
            <artifactId>mc3s-b2x-productcatalog-dto</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mindcurv.b2x.commons</groupId>
            <artifactId>mc3s-b2x-aggregator-base</artifactId>
            <version>${mc3s-b2x-commons.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mindcurv.b2x.commons</groupId>
            <artifactId>mc3s-b2x-adapter-services</artifactId>
            <version>${mc3s-b2x-commons.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mindcurv.b2x.productcatalog</groupId>
            <artifactId>mc3s-b2x-productreview-models</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest-maven.version}</version>
                <configuration>
                    <skip>${pitest.execution.skip}</skip>
                    <exportLineCoverage>true</exportLineCoverage>
                    <excludedClasses>${pitest.excludedClasses}</excludedClasses>
                    <mutationThreshold>${pitest.mutationThreshold}</mutationThreshold>
                    <coverageThreshold>${pitest.coverageThreshold}</coverageThreshold>
                    <skipFailingTests>${pitest.skipFailingTests}</skipFailingTests>
                    <timeoutConstant>${pitest.timeoutConstant}</timeoutConstant>
                    <failWhenNoMutations>${pitest.failWhenNoMutations}</failWhenNoMutations>
                    <outputFormats>
                        <outputFormat>CSV</outputFormat>
                        <outputFormat>XML</outputFormat>
                        <outputFormat>HTML</outputFormat>
                    </outputFormats>
                    <sourceDataFormats>
                        <sourceDataFormat>HTML</sourceDataFormat>
                    </sourceDataFormats>
                    <siteReportDirectory>pit</siteReportDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>run-mutation-tests</id>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5-plugin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>

