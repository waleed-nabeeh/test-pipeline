<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mindcurv.b2x.productcatalog</groupId>
        <artifactId>mc3s-b2x-productcatalog</artifactId>
        <version>0-SNAPSHOT</version>
    </parent>

    <groupId>com.mindcurv.b2x.api</groupId>
    <artifactId>mc3s-b2x-api-client-productcatalog</artifactId>
    <version>0-SNAPSHOT</version>
    <packaging>jar</packaging>


    <properties>
        <version>${project.version}</version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>${findbugs.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest-maven.version}</version>
                <configuration>
                    <skip>${pitest.execution.skip}</skip>
                    <exportLineCoverage>true</exportLineCoverage>
                    <excludedClasses>${pitest.excludedClasses}</excludedClasses>
                    <mutationThreshold>${pitest.mutationThreshold}</mutationThreshold>
                    <coverageThreshold>${pitest.coverageThreshold}</coverageThreshold>
                    <skipFailingTests>${pitest.skipFailingTests}</skipFailingTests>
                    <timeoutConstant>${pitest.timeoutConstant}</timeoutConstant>
                    <failWhenNoMutations>${pitest.failWhenNoMutations}</failWhenNoMutations>
                    <outputFormats>
                        <outputFormat>CSV</outputFormat>
                        <outputFormat>XML</outputFormat>
                        <outputFormat>HTML</outputFormat>
                    </outputFormats>
                    <sourceDataFormats>
                        <sourceDataFormat>HTML</sourceDataFormat>
                    </sourceDataFormats>
                    <siteReportDirectory>pit</siteReportDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>run-mutation-tests</id>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5-plugin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>openapi-yaml</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi-raw.json
                            </inputSpec>
                            <skipValidateSpec>true</skipValidateSpec>
                            <output>${project.basedir}/src/main/resources/</output>
                            <generatorName>openapi-yaml</generatorName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>plantuml</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/openapi.yaml
                            </inputSpec>
                            <skipValidateSpec>true</skipValidateSpec>
                            <output>${project.basedir}/../docs/uml/</output>
                            <generatorName>plantuml</generatorName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>html</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/openapi.yaml
                            </inputSpec>
                            <skipValidateSpec>true</skipValidateSpec>
                            <output>${project.basedir}/../docs/html/</output>
                            <generatorName>html</generatorName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>markdown</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/openapi.yaml
                            </inputSpec>
                            <skipValidateSpec>true</skipValidateSpec>
                            <output>${project.basedir}/../docs/markdown/</output>
                            <generatorName>markdown</generatorName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate_api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/openapi.yaml
                            </inputSpec>
                            <skipValidateSpec>true</skipValidateSpec>
                            <configOptions>
                                <sourceFolder>src/main/java</sourceFolder>
                                <serializableModel>true</serializableModel>
                                <interfaceOnly>true</interfaceOnly>
                                <useBeanValidation>true</useBeanValidation>
                                <useOptional>false</useOptional>
                                <useTags>true</useTags>
                                <dateLibrary>java8</dateLibrary>
                                <useJakartaEe>true</useJakartaEe>
                                <openApiNullable>false</openApiNullable>
                            </configOptions>
                            <modelPackage>${project.groupId}.productcatalog.models</modelPackage>
                            <apiPackage>${project.groupId}.productcatalog</apiPackage>
                            <invokerPackage>${project.groupId}.productcatalog.invoker
                            </invokerPackage>
                            <output>${project.build.directory}/generated-sources</output>
                            <generatorName>java</generatorName>
                            <library>resttemplate</library>
                            <generateApis>true</generateApis>
                            <generateApiTests>false</generateApiTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateSupportingFiles>true</generateSupportingFiles>
                            <generateAliasAsModel>false</generateAliasAsModel>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
