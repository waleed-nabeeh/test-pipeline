<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mindcurv.b2x.cloud</groupId>
        <artifactId>mc3s-b2x-cloud</artifactId>
        <version>0-SNAPSHOT</version>
    </parent>

    <artifactId>mc3s-b2x-azure-core</artifactId>
    <version>0-SNAPSHOT</version>
    <packaging>jar</packaging>


    <properties>
        <azure-sdk-bom.version>1.3.6</azure-sdk-bom.version>
        <azure-messaging-eventgrid.version>4.31.5</azure-messaging-eventgrid.version>
        <azure-messaging-eventhubs.version>5.21.3</azure-messaging-eventhubs.version>
        <azure-messaging-servicebus.version>7.17.17</azure-messaging-servicebus.version>
        <azure-openai.version>1.0.0-beta.16</azure-openai.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${azure-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud-dependencies.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.mindcurv.b2x.commons</groupId>
            <artifactId>mc3s-b2x-base</artifactId>
            <version>${mc3s-b2x-commons.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-messaging-servicebus</artifactId>
            <version>${azure-messaging-servicebus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-messaging-eventgrid</artifactId>
            <version>${azure-messaging-eventgrid.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-messaging-eventhubs</artifactId>
            <version>${azure-messaging-eventhubs.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-security-keyvault-secrets</artifactId>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-ai-openai</artifactId>
            <version>${azure-openai.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest-maven.version}</version>
                <configuration>
                    <skip>${pitest.execution.skip}</skip>
                    <exportLineCoverage>true</exportLineCoverage>
                    <excludedClasses>${pitest.excludedClasses}</excludedClasses>
                    <mutationThreshold>${pitest.mutationThreshold}</mutationThreshold>
                    <coverageThreshold>${pitest.coverageThreshold}</coverageThreshold>
                    <skipFailingTests>${pitest.skipFailingTests}</skipFailingTests>
                    <timeoutConstant>${pitest.timeoutConstant}</timeoutConstant>
                    <failWhenNoMutations>${pitest.failWhenNoMutations}</failWhenNoMutations>
                    <outputFormats>
                        <outputFormat>CSV</outputFormat>
                        <outputFormat>XML</outputFormat>
                        <outputFormat>HTML</outputFormat>
                    </outputFormats>
                    <sourceDataFormats>
                        <sourceDataFormat>HTML</sourceDataFormat>
                    </sourceDataFormats>
                    <siteReportDirectory>pit</siteReportDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>run-mutation-tests</id>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5-plugin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
