<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mindcurv.b2x.commons</groupId>
        <artifactId>mc3s-b2x-commons</artifactId>
        <version>0-SNAPSHOT</version>
    </parent>

    <artifactId>mc3s-b2x-adapter-shell</artifactId>
    <version>0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.mindcurv.b2x.commons</groupId>
            <artifactId>mc3s-b2x-commerce-services</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mindcurv.b2x.commons</groupId>
            <artifactId>mc3s-b2x-adapter-commercetools</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mindcurv.b2x.commons</groupId>
            <artifactId>mc3s-b2x-aggregator-base</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest-maven.version}</version>
                <configuration>
                    <skip>${pitest.execution.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>put-pit-together</id>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5-plugin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>