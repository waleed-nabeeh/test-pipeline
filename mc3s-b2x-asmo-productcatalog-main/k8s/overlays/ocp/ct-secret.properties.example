# Copy this file to ct-secret.properties and replace the example values.
# ct-secret.properties is ignored by Git and must never be committed.
projectKey=REPLACE_WITH_COMMERCETOOLS_PROJECT_KEY
clientId=REPLACE_WITH_COMMERCETOOLS_CLIENT_ID
clientSecret=REPLACE_WITH_COMMERCETOOLS_CLIENT_SECRET

# Optional values:
# scopes=manage_project:{projectKey}
# serviceRegion=GCP_EUROPE_WEST1
# apiUrl=https://api.europe-west1.gcp.commercetools.com
# authUrl=https://auth.europe-west1.gcp.commercetools.com
