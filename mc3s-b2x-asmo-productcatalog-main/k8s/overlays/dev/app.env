JAVA_TOOL_OPTIONS=-Dspring.profiles.active=dev -javaagent:/opentelemetry-javaagent.jar -Xms1300m -Xmx2000m
OTEL_EXPORTER=otlp_span
OTEL_EXPORTER_OTLP_ENDPOINT=http://mck8s-tempo.tempo.svc.cluster.local:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=mc3s-app-aggregator-productcatalog
OTEL_METRICS_EXPORTER=none
OTEL_LOG_LEVEL=debug
OTEL_LOGS_EXPORTER=none
OTEL_INSTRUMENTATION_HTTP_SERVER_CAPTURE_REQUEST_HEADERS="X-Store,X-Organization,X-Company,Content-Language"
CONNECT_ON_STARTUP=true


